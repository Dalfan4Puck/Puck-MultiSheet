# Copy to the VPS: /etc/puck/workshop-monitor.env
# chmod 600 /etc/puck/workshop-monitor.env

PUCK_SERVER_ROOT=/srv/puck-download
PUCK_SERVER_CONFIG=/srv/puck-download/server_config.json

# Workshop content lands under .../content/2994020/<item_id>/
WORKSHOP_CONTENT_APP_ID=2994020
# steamcmd workshop_download_item uses the dedicated-server app id
WORKSHOP_DOWNLOAD_APP_ID=3481440

STEAMCMD=steamcmd
# Optional — public workshop items usually work without a key
# STEAM_WEB_API_KEY=

STATE_FILE=/var/lib/puck-workshop-monitor/state.json
LOG_FILE=/var/log/puck-workshop-monitor.log
PUCK_RESTART_SCRIPT=/srv/puck-download/tools/puck_server/restart_puck_server.sh

# Adaptive polling (timer fires every FAST_POLL_SEC; script throttles in slow mode)
FAST_POLL_SEC=75
SLOW_POLL_SEC=600
SLOW_AFTER_SEC=10800

# Set to 1 for a dry run (log detections only, no download/restart)
DRY_RUN=0
