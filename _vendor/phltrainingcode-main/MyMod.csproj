<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Puck</GameDir>
    <GameManaged>$(GameDir)\Puck_Data\Managed</GameManaged>
    <LibsDir>$(ProjectDir)..\..\..\libs</LibsDir>
    <!-- Standalone only — MultiSheet hosts Flamie. Do not auto-redeploy into Plugins\FlamiePrac. -->
    <DeployDir Condition="'$(DeployDir)' == ''">$(ProjectDir)dist</DeployDir>
    <DistDir>$(ProjectDir)dist</DistDir>
    <DefineConstants>$(DefineConstants);FLAMIE_STANDALONE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Puck\**" />
    <Compile Remove="StaticCircularTarget.cs" />
    <Compile Remove="ChatPatch.cs" />
    <Compile Remove="GoalieController.cs" />
    <Compile Remove="GoalieStickController.cs" />
    <Compile Remove="TrainingGoalieLogic.cs" />
    <!-- MultiSheet-only (need PHLPracticeModPack). Standalone uses FlamiePracStandaloneShims.cs. -->
    <Compile Remove="FlamiePracRinkVisibility.cs" />
    <Compile Remove="FlamiePracRinkInterest.cs" />
    <!-- Class1 is already IPuckPlugin for blank-dedicated; avoid a second plugin type. -->
    <Compile Remove="FlamiePracPlugin.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Puck">
      <HintPath>$(LibsDir)\Puck.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameManaged)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(GameManaged)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManaged)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameManaged)\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameManaged)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GameManaged)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuildMoveDll" AfterTargets="Build">
    <MakeDir Directories="$(DeployDir)" />
    <MakeDir Directories="$(DistDir)" />

    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(DeployDir)\$(AssemblyName).dll"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFiles="$(DistDir)\$(AssemblyName).dll"
          OverwriteReadOnlyFiles="true" />

    <ItemGroup>
      <BundleFiles Include="$(ProjectDir)trainingprefabs*" />
      <BundleFiles Include="$(ProjectDir)*.bundle" />
      <BundleFiles Include="$(ProjectDir)*.assetbundle" />
      <BundleFiles Include="$(ProjectDir)*.unity3d" />
      <LayoutExample Include="$(ProjectDir)training_layout.example.json" />
      <NamesJson Include="$(ProjectDir)training_prefab_names.json" />
    </ItemGroup>

    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(DeployDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" Condition="'@(BundleFiles)' != ''" />
    <Copy SourceFiles="@(BundleFiles)" DestinationFolder="$(DistDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" Condition="'@(BundleFiles)' != ''" />

    <Copy SourceFiles="@(LayoutExample)"
          DestinationFiles="$(DeployDir)\training_layout.example.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LayoutExample.FullPath)')" />
    <Copy SourceFiles="@(LayoutExample)"
          DestinationFiles="$(DistDir)\training_layout.example.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LayoutExample.FullPath)')" />

    <!-- Blank dedicated: ship a ready-to-run layout (do not overwrite an operator-edited file). -->
    <Copy SourceFiles="@(LayoutExample)"
          DestinationFiles="$(DeployDir)\training_layout.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LayoutExample.FullPath)') AND !Exists('$(DeployDir)\training_layout.json')" />
    <Copy SourceFiles="@(LayoutExample)"
          DestinationFiles="$(DistDir)\training_layout.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(LayoutExample.FullPath)') AND !Exists('$(DistDir)\training_layout.json')" />

    <Copy SourceFiles="@(NamesJson)"
          DestinationFiles="$(DeployDir)\training_prefab_names.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NamesJson.FullPath)')" />
    <Copy SourceFiles="@(NamesJson)"
          DestinationFiles="$(DistDir)\training_prefab_names.json"
          SkipUnchangedFiles="true"
          Condition="Exists('%(NamesJson.FullPath)')" />

    <Copy SourceFiles="$(ProjectDir)SERVER_DEPLOY.md"
          DestinationFolder="$(DeployDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)SERVER_DEPLOY.md')" />
    <Copy SourceFiles="$(ProjectDir)SERVER_DEPLOY.md"
          DestinationFolder="$(DistDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)SERVER_DEPLOY.md')" />
    <Copy SourceFiles="$(ProjectDir)README.md"
          DestinationFolder="$(DistDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)README.md')" />

    <MakeDir Directories="$(DeployDir)\config" />
    <MakeDir Directories="$(DistDir)\config" />
    <Copy SourceFiles="$(ProjectDir)config\radio_client.example.json"
          DestinationFolder="$(DeployDir)\config"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)config\radio_client.example.json')" />
    <Copy SourceFiles="$(ProjectDir)config\radio_client.example.json"
          DestinationFolder="$(DistDir)\config"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)config\radio_client.example.json')" />

    <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(DeployDir)" />
    <Message Importance="high" Text="Archive copy at $(DistDir)" />
  </Target>

</Project>