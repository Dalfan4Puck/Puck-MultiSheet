    <Compile Include="$(FlamieDir)\TrainingObjectFactory.cs" Link="Flamie\TrainingObjectFactory.cs" />
    <Compile Include="$(FlamieDir)\TrainingObjectManager.cs" Link="Flamie\TrainingObjectManager.cs" />
    <Compile Include="$(FlamieDir)\TrainingPrefabNames.cs" Link="Flamie\TrainingPrefabNames.cs" />
    <Compile Include="$(FlamieDir)\TrainingPrefabRenamer.cs" Link="Flamie\TrainingPrefabRenamer.cs" />
