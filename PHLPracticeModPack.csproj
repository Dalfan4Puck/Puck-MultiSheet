  <Target Name="EnsureVendorPresent" BeforeTargets="CoreCompile"
            Condition="'$(IncludePuckLargeLevel)' == 'true'">
    <Error Condition="!Exists('$(PuckLargeLevelDir)\CL_ChunkRegistry.cs')"
           Text="Missing $(PuckLargeLevelDir). Run: PHLPracticeModPack\setup-vendor.ps1" />
  </Target>

  <Target Name="EnsureFlamiePresent" BeforeTargets="CoreCompile"
            Condition="'$(IncludeFlamiePrac)' == 'true'">
    <Error Condition="!Exists('$(FlamieDir)\MyMod.cs')"
           Text="Missing Flamie sources at $(FlamieDir)" />
    <Error Condition="!Exists('$(FlamieDir)\trainingprefabs')"
           Text="Missing Flamie AssetBundle at $(FlamieDir)\trainingprefabs" />
  </Target>

  <Target Name="CopyDeployOutputs" AfterTargets="Build">
    <!-- dist\ is the full Steam Workshop upload folder (DLL + Flamie assets + config + RadioSongs). -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(DeployDir)"
          OverwriteReadOnlyFiles="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\assemble-workshop-dist.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -Configuration $(Configuration)"
          IgnoreExitCode="false" />
    <Message Importance="high" Text="Workshop package ready → $(DeployDir) (upload the entire folder)" />
  </Target>
</Project>
