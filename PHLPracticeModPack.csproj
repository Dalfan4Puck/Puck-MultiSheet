    <Compile Include="$(FlamieDir)\MaxPractice\GoalieAIManager.cs" Link="Flamie\MaxPractice\GoalieAIManager.cs" />
    <Compile Include="$(FlamieDir)\MaxPractice\ModConfig.cs" Link="Flamie\MaxPractice\ModConfig.cs" />
    <Compile Include="$(FlamieDir)\MaxPractice\PracticeHelpers.cs" Link="Flamie\MaxPractice\PracticeHelpers.cs" />
