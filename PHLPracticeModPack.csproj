    <Compile Include="$(PuckLargeLevelDir)\CL_LevelEnvironment.cs" Link="LargeLevel\CL_LevelEnvironment.cs" />
    <Compile Include="$(PuckLargeLevelDir)\PuckSpawnSync.cs" Link="LargeLevel\PuckSpawnSync.cs" />
  </ItemGroup>

