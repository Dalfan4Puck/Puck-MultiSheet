    <OutputType>Library</OutputType>
    <AssemblyName>MultiSheet</AssemblyName>
    <RootNamespace>PHLPracticeModPack</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Puck</GameDir>
    <GameManaged>$(GameDir)\Puck_Data\Managed</GameManaged>
    <DeployDir>$(MSBuildProjectDirectory)\dist</DeployDir>
    <PuckLargeLevelDir>$(MSBuildProjectDirectory)\_vendor\PuckLargeLevel</PuckLargeLevelDir>
    <FlamieDir>$(MSBuildProjectDirectory)\_vendor\phltrainingcode-main</FlamieDir>
    <IncludePuckLargeLevel>true</IncludePuckLargeLevel>
    <IncludeFlamiePrac>true</IncludeFlamiePrac>
  </PropertyGroup>

